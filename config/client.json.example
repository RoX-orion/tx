{
    "listen": {
        "http": {"host": "127.0.0.1", "port": 8080},
        "socks5": {"host": "127.0.0.1", "port": 1080}
    },
    "udp": {
        "idle_timeout": 300,
        "max_flows": 4096,
        "quic_sniff": true
    },
    "limits": {
        "max_proxy_connections": 4096
    },
    "tun": {
        "enabled": true,
        "name": "TX-TUN",
        "mtu": 1500,
        "addresses": ["198.18.0.1/30", "fd00:198:18::1/126"],
        "auto_config": true,
        "auto_route": true,
        "auto_redirect": false,
        "redirect_port": 54321,
        "redirect_mark": 8228,
        "routes": [],
        "bypass_mark": 8228,
        "route_table": 20220,
        "rule_priority": 10000,
        "tcp_stack": "lwip",
        "udp_stack": "lwip"
    },
    "dns": {
        "mode": "fake-ip",
        "fake_ipv4_range": "198.18.0.0/16",
        "fake_ipv6_range": "fd00:198:18::/96",
        "cache_ttl": 60,
        "mapping_ttl": 1800,
        "cache_capacity": 4096
    },
    "outbounds": [
        {
            "tag": "direct-out",
            "type": "direct"
        },
        {
            "tag": "block",
            "type": "block"
        },
        {
            "tag": "proxy-out-tx",
            "type": "tx",
            "udp-over-tcp": true,
            "udp-mux": {"connections": 1},
            "server": {
                "host": "your-host",
                "port": 443,
                "secret": "uuid-v4:your-uuid-v4",
                "cipher": "aes-256-gcm"
            }
        }
    ],
    "routing": {
        "domainStrategy": "AsIs",
        "geoip_path": "geoip.dat",
        "geosite_path": "geosite.dat",
        "rules": [
            {
                "ip": ["geoip:private"],
                "outboundTag": "direct-out"
            },
            {
                "domain": ["geosite:category-ads-all"],
                "outboundTag": "block"
            },
            {
                "domain": ["geosite:cn"],
                "outboundTag": "direct-out"
            },
            {
                "ip": ["geoip:cn"],
                "outboundTag": "direct-out"
            },
            {
                "domain": ["geosite:geolocation-!cn"],
                "outboundTag": "proxy-out-tx"
            },
            {
                "outboundTag": "proxy-out-tx"
            }
        ]
    },
    "log_level": "info"
}
